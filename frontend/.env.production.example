# Copier en .env.production.local et remplir avec la config du vrai projet Firebase
# (Console Firebase > Paramètres du projet > Vos applications > SDK setup and configuration > Config).
# Ces valeurs ne sont pas secrètes : la sécurité repose sur firestore.rules.
VITE_USE_EMULATORS=false
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
