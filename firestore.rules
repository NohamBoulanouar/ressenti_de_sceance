rules_version = '2';

// Le navigateur ne parle jamais directement à Firestore :
// toutes les lectures/écritures passent par l'API Spring Boot (SDK Admin),
// qui contrôle les droits athlète / coach. On ferme donc tout accès direct.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
