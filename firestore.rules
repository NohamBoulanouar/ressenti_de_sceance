rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// Sécurité de "Ressenti de séance" : le site parle directement à Firestore,
// donc TOUS les droits sont contrôlés ici.
//
//  users/{uid}            profil : name, poste, role (ATHLETE|COACH|DEV), email, joinCode, consentAt, createdAt
//                         DEV = développeur : mêmes droits qu'un coach, rôle attribuable UNIQUEMENT depuis la console Firebase
//  responses/{uid_date}   une réponse par athlète et par séance
//  teamCodes/{code}       codes d'équipe valides (lisibles par les coachs uniquement)
//  removed/{uid}          membres retirés par un coach : ne peuvent plus se réinscrire
//  sessions/{id}          séances planifiées par le coach (date, heure, titre)
//  responses/{uid_sessionId}  une réponse par athlète et par séance
//  meta/setup             créé une seule fois, quand le tout premier compte devient coach
// ─────────────────────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function hasProfile() { return signedIn() && exists(userPath(request.auth.uid)); }
    function me() { return get(userPath(request.auth.uid)).data; }
    // "Staff" = coach ou développeur : accès au suivi et à la gestion de l'équipe.
    function isCoach() { return hasProfile() && me().role in ['COACH', 'DEV']; }

    function postes() { return ['1ère ligne', '2ème ligne', '3ème ligne', '9/10', 'Centres', 'Arrières']; }
    function isDate(d) { return d is string && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function sessionPath(id) { return /databases/$(database)/documents/sessions/$(id); }

    function validName(n) { return n is string && n.trim().size() > 0 && n.size() <= 60; }
    // Un athlète a un poste ; un coach n'en a pas (chaîne vide), ou garde celui qu'il avait comme athlète.
    function validPoste(role, p) {
      return (role == 'ATHLETE' && p in postes()) || (role in ['COACH', 'DEV'] && (p == '' || p in postes()));
    }

    // ── Profils ────────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isCoach());

      function validNewProfile(d) {
        return d.keys().hasOnly(['name', 'poste', 'role', 'email', 'joinCode', 'consentAt', 'createdAt'])
          && d.keys().hasAll(['name', 'poste', 'role', 'email', 'consentAt', 'createdAt'])
          && validName(d.name)
          && validPoste(d.role, d.poste)
          && d.email == request.auth.token.email
          && d.consentAt == request.time      // consentement RGPD horodaté par le serveur
          && d.createdAt == request.time;
      }

      // Création : soit athlète avec un code d'équipe valide,
      // soit tout premier compte de l'équipe (devient coach, crée meta/setup dans le même lot).
      allow create: if signedIn() && request.auth.uid == uid
        && validNewProfile(request.resource.data)
        && (
          (request.resource.data.role == 'ATHLETE'
            && !exists(/databases/$(database)/documents/removed/$(uid))
            && request.resource.data.joinCode is string
            && exists(/databases/$(database)/documents/teamCodes/$(request.resource.data.joinCode)))
          ||
          (request.resource.data.role == 'COACH'
            && !exists(/databases/$(database)/documents/meta/setup)
            && existsAfter(/databases/$(database)/documents/meta/setup))
        );

      // Modification par soi-même : nom et poste uniquement.
      // Modification par un coach : rôle d'un AUTRE compte uniquement
      // (un coach ne peut pas se retirer lui-même, il reste donc toujours au moins un coach).
      allow update: if signedIn() && (
        (request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'poste'])
          && validName(request.resource.data.name)
          && validPoste(resource.data.role, request.resource.data.poste))
        ||
        (isCoach() && request.auth.uid != uid
          && resource.data.role != 'DEV'                       // personne ne touche au rôle d'un dev
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
          && request.resource.data.role in ['ATHLETE', 'COACH'])   // DEV ne s'attribue pas depuis le site
      );

      // Suppression : son propre compte (RGPD), ou un athlète retiré de l'équipe par un coach.
      // Un coach ne peut pas être supprimé directement (qu'un autre coach le repasse d'abord athlète).
      allow delete: if signedIn() && resource.data.role == 'ATHLETE'
        && (request.auth.uid == uid || isCoach());
    }

    // ── Réponses ───────────────────────────────────────────────────────────────
    match /responses/{id} {
      function score(v) { return v is int && v >= 1 && v <= 100; }

      function notFuture(d) {
        // pas de séance dans le futur (marge d'un jour pour les fuseaux horaires)
        return timestamp.date(int(d[0:4]), int(d[5:7]), int(d[8:10])) <= request.time + duration.value(1, 'd');
      }

      function validResponse(r) {
        // (le champ 'opp' n'est plus demandé : il reste accepté pour les anciennes réponses)
        return r.keys().hasOnly(['uid', 'name', 'poste', 'sessionId', 'date', 'mus', 'car', 'rep', 'conc', 'pla', 'conf', 'tec', 'tac', 'opp', 'blessure', 'gene', 'updatedAt'])
          && r.uid == request.auth.uid
          && r.sessionId is string
          && id == r.uid + '_' + r.sessionId     // une seule réponse par athlète et par séance
          && exists(sessionPath(r.sessionId))    // la séance doit avoir été planifiée par le coach
          && get(sessionPath(r.sessionId)).data.date == r.date
          && isDate(r.date) && notFuture(r.date)
          // athlètes, coachs et dev peuvent répondre ; seules les réponses des athlètes comptent dans le suivi
          && r.name == me().name && r.poste == me().poste
          && score(r.mus) && score(r.car) && score(r.rep)
          && score(r.conc) && score(r.pla) && score(r.conf)
          && score(r.tec) && score(r.tac)
          && (!('opp' in r) || score(r.opp))
          && r.blessure is bool
          && r.gene is string && r.gene.size() <= 200
          && r.updatedAt == request.time;
      }

      // Lecture d'un document précis : le sien (même s'il n'existe pas encore) ou n'importe lequel pour un coach.
      allow get: if hasProfile() && (id.split('_')[0] == request.auth.uid || isCoach());
      // Requêtes : un athlète doit filtrer sur son uid, un coach peut tout lister.
      allow list: if hasProfile() && (resource.data.uid == request.auth.uid || isCoach());
      allow create, update: if hasProfile() && validResponse(request.resource.data)
        && (resource == null || resource.data.uid == request.auth.uid);
      // Suppression : ses propres réponses, ou n'importe lesquelles pour un coach (membre retiré, fin de saison).
      allow delete: if hasProfile() && (resource.data.uid == request.auth.uid || isCoach());
    }

    // ── Séances planifiées ─────────────────────────────────────────────────────
    match /sessions/{sid} {
      function validSession(d) {
        return d.keys().hasOnly(['date', 'time', 'title', 'createdAt', 'createdBy'])
          && isDate(d.date)
          && d.time is string && (d.time == '' || d.time.matches('^[0-2][0-9]:[0-5][0-9]$'))
          && d.title is string && d.title.trim().size() > 0 && d.title.size() <= 60
          && d.createdBy is string && d.createdAt is timestamp;
      }
      allow read: if hasProfile();
      allow create: if isCoach() && validSession(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time;
      allow update: if isCoach() && validSession(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['date', 'time', 'title']);
      allow delete: if isCoach();
    }

    // ── Membres retirés ────────────────────────────────────────────────────────
    match /removed/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isCoach());
      allow list: if isCoach();
      allow create: if isCoach() && request.auth.uid != uid
        && !existsAfter(userPath(uid))         // seulement avec la suppression du profil (donc jamais un coach ou un dev)
        && request.resource.data.keys().hasOnly(['name', 'email', 'at', 'by'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time;
      allow delete: if isCoach();
    }

    // ── Codes d'équipe ─────────────────────────────────────────────────────────
    match /teamCodes/{code} {
      allow read: if isCoach();
      allow create: if isCoach() && code.matches('^[A-Z0-9]{6,20}$')
        && request.resource.data.keys().hasOnly(['createdAt', 'createdBy'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow delete: if isCoach();
    }

    // ── Initialisation (premier coach) ─────────────────────────────────────────
    match /meta/setup {
      allow read: if signedIn();
      allow create: if signedIn() && !exists(/databases/$(database)/documents/meta/setup)
        && request.resource.data.keys().hasOnly(['firstCoach', 'at'])
        && request.resource.data.firstCoach == request.auth.uid
        && request.resource.data.at == request.time
        && getAfter(userPath(request.auth.uid)).data.role == 'COACH';
    }

    // Tout le reste est fermé.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
